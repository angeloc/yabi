[Unit]
Description=yabi boot splash
DefaultDependencies=no
After=systemd-udev-trigger.service
Before=sysinit.target

[Service]
Type=oneshot
EnvironmentFile=-/etc/default/yabi
ExecStart=/usr/bin/yabi start $YABI_THEME
# Follows systemd's own boot progress until the splash is gone
ExecStartPost=/usr/bin/yabi watch
RemainAfterExit=yes

[Install]
WantedBy=sysinit.target
