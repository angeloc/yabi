#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-or-later
# Shows the boot splash and follows the boot: the progress moves as the
# init scripts run, with nothing to change in them or in rc.

YABI_THEME=default
YABI_WATCH=/etc/init.d
[ -r /etc/default/yabi ] && . /etc/default/yabi

case "$1" in
start)
	yabi ping 2>/dev/null && exit 0
	yabi start "$YABI_THEME" && yabi watch $YABI_WATCH
	;;
stop)
	yabi quit 2>/dev/null
	exit 0
	;;
*)
	echo "Usage: $0 {start|stop}" >&2
	exit 2
	;;
esac
