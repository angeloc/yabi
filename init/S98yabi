#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-or-later
# Ends the boot splash: a progress theme goes to 100% and freezes once the
# animation got there, a loop theme just freezes; then the splash closes as
# YABI_QUIT in /etc/default/yabi says. With retain its last picture stays on
# the framebuffer for the application starting after it.

YABI_QUIT=yes
[ -r /etc/default/yabi ] && . /etc/default/yabi

[ "$1" = start ] || exit 0
yabi freeze 2>/dev/null || exit 0
case "$YABI_QUIT" in
yes) yabi quit 2>/dev/null ;;
retain) yabi --retain quit 2>/dev/null ;;
esac
exit 0
