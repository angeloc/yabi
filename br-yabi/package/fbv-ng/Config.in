config BR2_PACKAGE_FBV_NG
	bool "fbv-ng"
	depends on BR2_INSTALL_LIBSTDCPP
	depends on BR2_TOOLCHAIN_GCC_AT_LEAST_10 # C++20
	depends on !BR2_PACKAGE_FBV # both install /usr/bin/fbv
	help
	  Framebuffer image viewer, a C++20 rewrite of fbv with
	  animated GIFs and a control socket. BMP is built in; PNG,
	  JPEG and GIF support follow libpng, jpeg and giflib.

	  https://github.com/angeloc/fbv-ng

comment "fbv-ng needs a toolchain w/ C++, gcc >= 10"
	depends on !BR2_INSTALL_LIBSTDCPP || !BR2_TOOLCHAIN_GCC_AT_LEAST_10
